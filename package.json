{
  "name": "rayspace-tekken-scoreboard",
  "version": "1.0.1",
  "description": "铁拳8 比赛记分板：透明置顶、OBS 浏览器源及全局快捷键",
  "main": "src/main.cjs",
  "author": "RAYSPACE",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "node src/server.cjs",
    "test": "node --test test/*.test.cjs",
    "pack:win": "node scripts/build-installer.cjs",
    "pack:linux": "electron-builder --linux dir",
    "setup:electron": "node node_modules/electron/install.js",
    "pack:win:zip": "electron-builder --win zip --x64 -c.win.artifactName=RAYSPACE-Scoreboard-${version}-Windows-x64.zip"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.rayspace.tekken.scoreboard",
    "productName": "RAYSPACE Scoreboard",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": true,
      "artifactName": "RAYSPACE-Scoreboard-Setup-${version}.exe",
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "dir"
    },
    "extraFiles": [
      {
        "from": "README.md",
        "to": "使用说明.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE-RAYSPACE.txt"
      }
    ],
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "zh-TW",
      "en-US"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RAYSPACE 铁拳8记分板",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "RAYSPACE-Scoreboard-Setup-${version}.exe",
      "differentialPackage": false
    }
  }
}
